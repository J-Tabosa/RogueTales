; Godot 4.7 — open this file in the project manager.
config_version=5

[application]
config/version="0.9.1"
config/icon="res://assets/ui/logo.png"
config/name="RogueTales: O Último Fio"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/mode=3
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/resizable=true
window/size/min_width=360
window/size/min_height=640

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.065, 1)

textures/vram_compression/import_etc2_astc=true
